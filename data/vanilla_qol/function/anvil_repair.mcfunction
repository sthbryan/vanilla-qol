# Restores every worn anvil within 6 blocks, keeping the way it faces.
fill ~-6 ~-6 ~-6 ~6 ~6 ~6 anvil[facing=north] replace chipped_anvil[facing=north]
fill ~-6 ~-6 ~-6 ~6 ~6 ~6 anvil[facing=south] replace chipped_anvil[facing=south]
fill ~-6 ~-6 ~-6 ~6 ~6 ~6 anvil[facing=east] replace chipped_anvil[facing=east]
fill ~-6 ~-6 ~-6 ~6 ~6 ~6 anvil[facing=west] replace chipped_anvil[facing=west]
fill ~-6 ~-6 ~-6 ~6 ~6 ~6 anvil[facing=north] replace damaged_anvil[facing=north]
fill ~-6 ~-6 ~-6 ~6 ~6 ~6 anvil[facing=south] replace damaged_anvil[facing=south]
fill ~-6 ~-6 ~-6 ~6 ~6 ~6 anvil[facing=east] replace damaged_anvil[facing=east]
fill ~-6 ~-6 ~-6 ~6 ~6 ~6 anvil[facing=west] replace damaged_anvil[facing=west]
